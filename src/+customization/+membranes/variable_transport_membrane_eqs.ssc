component variable_transport_membrane_eqs
% Variable Transport Membrane EQs
% Models membrane transport dynamics between two chambers with variable 
% transport parameters.
%
% Copyright 2021-2026 Professor Maha N. Haji, director of the Symbiotic Engineering of Analysis Lab
% Authored by: Nate DeGoede and Maha N. Haji
% For questions or concerns, please email: degoeden@umich.edu and mhaji@umich.edu

nodes
    % this is just needed for access to the tables
    F = customization.solution.solution; % F
end

outputs
    mdot_A_x = {0, 'kg/s'}; % mdot_A_x
    mdot_B_x = {0, 'kg/s'}; % mdot_B_x
    mdot_A_w = {0, 'kg/s'}; % mdot_A_w
    mdot_B_w = {0, 'kg/s'}; % mdot_B_w
    Phi_A = {0, 'W'};       % Phi_A
end

inputs
    P_A = {1, 'atm'};       % P_A
    T_A = {300, 'K'};       % T_A
    x_A = {0, 'kg/m^3'};    % x_A
    P_B = {1, 'atm'};       % P_B
    T_B = {300, 'K'};       % T_B
    x_B = {0, 'kg/m^3'};    % x_B
    a_loss = {0, '1'};      % Area Loss
end

annotations
    [mdot_A_x, mdot_A_w, P_A, T_A, x_A] : Side = top;
    [mdot_B_x, mdot_B_w, P_B, T_B, x_B] : Side = bottom;
    Phi_A : Side = right;
    a_loss : Side = right;
    Phi_B : Side = right;
    F : Side = left;
end

parameters
    a_1 = {0.03528, 'l/(m^2*hr*psi)'};   %   Water permeability parameter 1
    a_2 = {0.01085, '1/psi'};           %   Water permeability paramerer 2
    a_3 = {0.09831, 'l/(m^2*hr*psi)'};   %   Water permeability parameter 3
    b_1 = {0.01331, 'l/(m^2*hr)'};       %   Salt permeability parameter 1
    b_2 = {0.15060, '1/psi'};          %   Salt permeability parameter 2
    b_3 = {0.06588, 'l/(m^2*hr)'};       %   Salt permeability parameter 3
    A_m = {35, 'm^2'};              % Membrane Area
end

outputs
    Phi_B = {0, 'W'};       % Phi_B
end

% Osmotic pressures
intermediates
    % iM_A = F.i*(x_A/F.M);
    % iM_B = F.i*(x_B/F.M);
    pi_A = F.i*(x_A/F.M)*F.R*T_A;  
    pi_B = F.i*(x_B/F.M)*F.R*T_B;
    del_pi = pi_A - pi_B;
end

% Membrane transport parameters
intermediates
    NDP = P_A - P_B - del_pi; % for now without polarization
    A_w = a_1*exp(-a_2*NDP) + a_3;
    B_s = b_1*log(b_2*NDP) + b_3;
end

components (ExternalAccess = observe)
    membrane_eqs = customization.membranes.membrane_eqs(A_m=A_m,...
        coefficient_type = foundation.enum.constant_variable.variable);
end

equations
    A_w==membrane_eqs.A
    B_s==membrane_eqs.B
end

connections
    connect(P_A,membrane_eqs.P_A)
    connect(T_A,membrane_eqs.T_A)
    connect(x_A,membrane_eqs.x_A)
    connect(membrane_eqs.mdot_A_w,mdot_A_w)
    connect(membrane_eqs.mdot_A_x,mdot_A_x)
    connect(membrane_eqs.Phi_A,Phi_A)
    connect(a_loss,membrane_eqs.a_loss)
    connect(F,membrane_eqs.F)
    connect(P_B,membrane_eqs.P_B)
    connect(T_B,membrane_eqs.T_B)
    connect(x_B,membrane_eqs.x_B)
    connect(membrane_eqs.mdot_B_w,mdot_B_w)
    connect(membrane_eqs.mdot_B_x,mdot_B_x)
    connect(membrane_eqs.Phi_B,Phi_B)
end

end
