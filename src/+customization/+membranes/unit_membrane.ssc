component unit_membrane
% Unit Membrane (SS) 
% This block models a single section of a membrane.
%
% Copyright 2021-2025 Professor Maha N. Haji, director of the Symbiotic Engineering of Analysis Lab
% Authored by: Nate DeGoede and Maha N. Haji
% For questions or concerns, please email: degoeden@umich.edu and mhaji@umich.edu

nodes
    F = customization.solution.solution;    % Feed:left
    B = customization.solution.solution;    % Brine:right
    P1 = customization.solution.solution;   % Permeate Upstream:left
    P2 = customization.solution.solution;   % Permeate Downstream:right
end

annotations
    Icon = 'membrane.svg';
end

parameters (ExternalAccess = none)
    A_w = {2.57e-12, 'm^3/(N*s)'}; % Membrane Permeability
    B_s = {2.30e-8, 'm/s'};            % Solute transport parameter
    B_s_y = {2.30e-8, 'm/s'};          % Second solute transport parameter
    B_s_z = {2.30e-8, 'm/s'};          % Third solute transport parameter
end

parameters (ExternalAccess = none)
    A_table = {[2.57e-12,2.57e-12,2.57e-12], 'm^3/(N*s)'};  % Membrane Permeability
    B_table = {[2.30e-8,2.30e-8,2.30e-8], 'm/s'};           % Solute transport parameter
    B_table_y = {[2.30e-8,2.30e-8,2.30e-8], 'm/s'};         % Second solute transport parameter
    B_table_z = {[2.30e-8,2.30e-8,2.30e-8], 'm/s'};         % Third solute transport parameter
    NDP_index = {[0.1,2,5], 'MPa'};                         % Net driving pressure, for permeability data points
end

parameters
    A_m = {35, 'm^2'};              % Membrane Unit Area
    length = {1, 'm'};              % Membrane Unit Length
    D_feed = {3, 'mm'};             % Feed channel hydraulic diameter
    area_feed = {10, 'mm^2'};       % Feed channel cross sectional area
    D_perm = {25, 'mm'};            % Permeate channel hydraulic diameter
    custom_ports = false;           % Set custom port lengths, defaults to 1/2 length
    polarization_type = customization.membranes.polarization_options.none; % How to account for polarization effects
    %                   1 - none
    %                   2 - boundary layer, discrete volume section near surface
    %                   3 - exponential modifier on concentration seen by membrane
    dynamic_compressibility = true; % Fluid dynamic compressibility
end

parameters (ExternalAccess = none)
    boundary_height = {0.05,'mm'};      % Boundary layer height
    boundary_port = {0.05,'mm'}; % Boundary layer port length
    Re_min = {0.1, '1'};                % Minimum Reynolds number for Sherwood number
end

parameters
    scaling_x = false;                  % Scaling solute x
    scaling_y = false;                  % Scaling solute y
    scaling_z = false;                  % Scaling solute z
end
parameters (ExternalAccess = none)
    x_eq = {1e15,'g/l'};               % Solvent Equilibrium Concentration
    K_G_x = {0,'m/s'};                 % Crystal Growth Constant (x)
    s_x = {1,'1'};                     % Concentration Difference Exponent (x)
    A_nucleation_x = {1e-30,'m^2'};    % Area of scale at nucleation site (x)
    aspect_ratio_x = {0.9,'1'};        % Aspect ratio of scale ellipsoids (x)
    scales_per_area_x = {0,'1/cm^2'};  % Scale nucleation sites per membrane area (x)
    alpha_x = {1000,'1/m'};            % Membrane area recovery (x)
    F_detach_x = {1,'Pa'};             % Pressure required to detach scale (x)
    F_detach_buffer_x = {1e-3,'N'};    % Buffer on F_detach (x)
    Mscale_x0 = {0,'kg'};             % Initial Scale Mass (x)

    y_eq = {1e15,'g/l'};               % Second Solvent Equilibrium Concentration
    K_G_y = {0,'m/s'};                 % Crystal Growth Constant (y)
    s_y = {1,'1'};                     % Concentration Difference Exponent (y)
    A_nucleation_y = {1e-30,'m^2'};    % Area of scale at nucleation site (y)
    aspect_ratio_y = {0.9,'1'};        % Aspect ratio of scale ellipsoids (y)
    scales_per_area_y = {0,'1/cm^2'};  % Scale nucleation sites per membrane area (y)
    alpha_y = {1000,'1/m'};            % Membrane area recovery (y)
    F_detach_y = {1,'Pa'};             % Pressure required to detach scale (y)
    F_detach_buffer_y = {1e-3,'N'};    % Buffer on F_detach (y)
    Mscale_y0 = {0,'kg'};             % Initial Scale Mass (y)

    z_eq = {1e15,'g/l'};               % Third Solvent Equilibrium Concentration
    K_G_z = {0,'m/s'};                 % Crystal Growth Constant (z)
    s_z = {1,'1'};                     % Concentration Difference Exponent (z)
    A_nucleation_z = {1e-30,'m^2'};    % Area of scale at nucleation site (z)
    aspect_ratio_z = {0.9,'1'};        % Aspect ratio of scale ellipsoids (z)
    scales_per_area_z = {0,'1/cm^2'};  % Scale nucleation sites per membrane area (z)
    alpha_z = {1000,'1/m'};            % Membrane area recovery (z)
    F_detach_z = {1,'Pa'};             % Pressure required to detach scale (z)
    F_detach_buffer_z = {1e-3,'N'};    % Buffer on F_detach (z)
    Mscale_z0 = {0,'kg'};             % Initial Scale Mass (z)
end

if polarization_type == customization.membranes.polarization_options.discrete
    annotations
        boundary_height : ExternalAccess = modify;
    end
    if custom_ports
        annotations
            boundary_port : ExternalAccess = modify;
        end
        parameters (ExternalAccess = none)
            boundary_port_length = boundary_port;
        end
    else
        parameters (ExternalAccess = none)
            boundary_port_length = boundary_height;
        end
    end
end

if polarization_type == customization.membranes.polarization_options.modifier
    annotations
        Re_min : ExternalAccess = modify;
    end
    parameters (ExternalAccess = none)
        internal_concentration_gradient = true;
    end
else
    parameters (ExternalAccess = none)
        internal_concentration_gradient = false;
    end
end

if scaling_x
    annotations
        x_eq                : ExternalAccess = modify;
        K_G_x               : ExternalAccess = modify;
        s_x                 : ExternalAccess = modify;
        A_nucleation_x      : ExternalAccess = modify;
        aspect_ratio_x      : ExternalAccess = modify;
        scales_per_area_x   : ExternalAccess = modify;
        alpha_x             : ExternalAccess = modify;
        F_detach_x          : ExternalAccess = modify;
        F_detach_buffer_x   : ExternalAccess = modify;
        Mscale_x0           : ExternalAccess = modify;
    end
end
if scaling_y
    annotations
        y_eq                : ExternalAccess = modify;
        K_G_y               : ExternalAccess = modify;
        s_y                 : ExternalAccess = modify;
        A_nucleation_y      : ExternalAccess = modify;
        aspect_ratio_y      : ExternalAccess = modify;
        scales_per_area_y   : ExternalAccess = modify;
        alpha_y             : ExternalAccess = modify;
        F_detach_y          : ExternalAccess = modify;
        F_detach_buffer_y   : ExternalAccess = modify;
        Mscale_y0           : ExternalAccess = modify;
    end
end
if scaling_z
    annotations
        z_eq                : ExternalAccess = modify;
        K_G_z               : ExternalAccess = modify;
        s_z                 : ExternalAccess = modify;
        A_nucleation_z      : ExternalAccess = modify;
        aspect_ratio_z      : ExternalAccess = modify;
        scales_per_area_z   : ExternalAccess = modify;
        alpha_z             : ExternalAccess = modify;
        F_detach_z          : ExternalAccess = modify;
        F_detach_buffer_z   : ExternalAccess = modify;
        Mscale_z0           : ExternalAccess = modify;
    end
end

parameters (ExternalAccess = none)
    portlength_A_feed = {1e-3,'m'};
    portlength_B_feed = {1e-3,'m'};
    portlength_A_perm = {1e-3,'m'};
    portlength_B_perm = {1e-3,'m'};
end

parameters
    coefficient_type = foundation.enum.constant_variable.constant;  % Membrane transport parameter specification
    %                                                            1 - Constant
    %                                                            2 - Variable
end

parameters
    P0_feed = {1, 'MPa'};           % Feed Pressure
    P0_perm = {0.101, 'MPa'};       % Permeate Pressure
    x0_feed = {50, 'kg/m^3'};       % Feed Concentration
    x0_perm = {0, 'kg/m^3'};        % Permeate Concentration
    y0_feed = {0, 'kg/m^3'};        % Feed Second Species Concentration
    y0_perm = {0, 'kg/m^3'};        % Permeate Second Species Concentration
    z0_feed = {0, 'kg/m^3'};        % Feed Third Species Concentration
    z0_perm = {0, 'kg/m^3'};        % Permeate Third Species Concentration
end

% Parameter groups
annotations
    UILayout = [
        UIGroup('physmod:simscape:library:tabs:Parameters', ...
            A_w,B_s,B_s_y,B_s_z,A_table,B_table,B_table_y,B_table_z,NDP_index,A_m,length,D_feed,area_feed,D_perm,coefficient_type,polarization_type,boundary_height,Re_min)
        UIGroup('physmod:simscape:library:tabs:EffectsAndInitialConditions', ...
            dynamic_compressibility,P0_feed,P0_perm,x0_feed,x0_perm,y0_feed,y0_perm,z0_feed,z0_perm)
        UIGroup("Port Lengths",custom_ports,portlength_A_feed,portlength_B_feed,portlength_A_perm,portlength_B_perm,boundary_port)
        UIGroup("Scaling",scaling_x,x_eq,K_G_x,s_x,A_nucleation_x,aspect_ratio_x,scales_per_area_x,alpha_x,F_detach_x,F_detach_buffer_x,Mscale_x0,...
                          scaling_y,y_eq,K_G_y,s_y,A_nucleation_y,aspect_ratio_y,scales_per_area_y,alpha_y,F_detach_y,F_detach_buffer_y,Mscale_y0,...
                          scaling_z,z_eq,K_G_z,s_z,A_nucleation_z,aspect_ratio_z,scales_per_area_z,alpha_z,F_detach_z,F_detach_buffer_z,Mscale_z0)
    ];
end

if coefficient_type == foundation.enum.constant_variable.constant
    annotations
        A_w : ExternalAccess = modify;
        B_s: ExternalAccess = modify;
        B_s_y: ExternalAccess = modify;
        B_s_z: ExternalAccess = modify;
    end
    components
        membrane_eqs = customization.membranes.membrane_eqs(...
                            A_w=A_w,B_s=B_s,B_s_y=B_s_y,B_s_z=B_s_z,A_m=A_m);
    end
else % coefficient_type == foundation.enum.constant_variable.variable
    annotations
        A_table : ExternalAccess = modify;
        B_table: ExternalAccess = modify;
        B_table_y: ExternalAccess = modify;
        B_table_z: ExternalAccess = modify;
        NDP_index: ExternalAccess = modify;
    end
    components
        membrane_eqs = customization.membranes.membrane_eqs(...
                        A_table=A_table,B_table=B_table,B_table_y=B_table_y,B_table_z=B_table_z,...
                        NDP_index=NDP_index,A_m=A_m,...
                        coefficient_type=coefficient_type);
    end
end
if custom_ports
    annotations
        portlength_A_feed : ExternalAccess = modify;
        portlength_B_feed : ExternalAccess = modify;
        portlength_A_perm : ExternalAccess = modify;
        portlength_B_perm : ExternalAccess = modify;
    end
    parameters (ExternalAccess = none)
        length_A_feed = portlength_A_feed;
        length_B_feed = portlength_B_feed;
        length_A_perm = portlength_A_perm;
        length_B_perm = portlength_B_perm;
    end
    equations
        assert(portlength_A_feed > 0)
        assert(portlength_B_feed > 0)
        assert(portlength_A_perm > 0)
        assert(portlength_B_perm > 0)
    end
else
    parameters (ExternalAccess = none)
        length_A_feed = length/2;
        length_B_feed = length/2;
        length_A_perm = length/2;
        length_B_perm = length/2;
    end
end


parameters (ExternalAccess=none)
    roughness    = {15e-6,    'm'   };  % Internal surface absolute roughness
    Re_lam       = {2000,     '1'   };  % Laminar flow upper Reynolds number limit
    Re_tur       = {4000,     '1'   };  % Turbulent flow lower Reynolds number limit
    shape_factor = {64,       '1'   };  % Laminar friction constant for Darcy friction factor
    area_perm = pi*(D_perm/2)^2;        % Permeate channel cross sectional area
    Nu_lam       = {3.66,     '1'   };  % Nusselt number for laminar flow heat transfer
end

if polarization_type == customization.membranes.polarization_options.discrete
    components (ExternalAccess = observe)
        feed_pipe1 = customization.solution.elements.pipe_resistance(...
                            length = length/2, area = area_feed, Dh = D_feed,...
                            roughness = roughness,...
                            Re_lam = Re_lam, Re_tur = Re_tur,...
                            shape_factor = shape_factor,...
                            custom_ports = true,... 
                            length_A = length_A_feed/3, length_B = length_A_feed/3);
    
        feed_chamber = customization.solution.elements.constant_volume_chamber(...
                            volume = length*area_feed, num_ports = 3,...
                            area_A = area_feed, area_B = area_feed, area_C = A_m,...
                            custom_ports = true,...
                            length_A = length_A_feed/3, length_B = length_A_feed/3,...
                            length_C = boundary_port_length/4,...
                            p_measure = true, t_measure = true, x_measure = true, y_measure = true, z_measure = true,...
                            p0 = P0_feed, x0 = x0_feed, y0 = y0_feed, z0 = z0_feed);

        boundary_chamber = customization.solution.elements.constant_volume_chamber(...
                            volume = A_m*boundary_height, num_ports = 1,...
                            area_A = A_m, custom_ports = true,...
                            length_A = boundary_port_length/4,...
                            p_measure = true, t_measure = true, x_measure = true, y_measure = true, z_measure = true,...
                            dM_X_source = true, dM_Y_source = true, dM_Z_source = true,...
                            dM_W_source = true, phi_source = true,...
                            p0 = P0_feed, x0 = x0_feed, y0 = y0_feed, z0 = z0_feed);

        feed_pipe2 = customization.solution.elements.pipe_resistance(...
                            length = length/2, area = area_feed, Dh = D_feed,...
                            roughness = roughness,...
                            Re_lam = Re_lam, Re_tur = Re_tur,...
                            shape_factor = shape_factor,...
                            custom_ports = true,...
                            length_A = length_B_feed/3, length_B = length_B_feed/3);
    end
else
    components (ExternalAccess = observe)
        feed_chamber = customization.scaling.pipe_with_scaling(...
                            length = length, area = area_feed, Dh = D_feed,...
                            perimeter = A_m/length,...
                            length_add = 0, roughness = roughness,...
                            Re_lam = Re_lam, Re_tur = Re_tur,...
                            shape_factor = shape_factor, Nu_lam = Nu_lam,...
                            p0 = P0_feed, x0 = x0_feed, y0 = y0_feed, z0 = z0_feed,...
                            p_measure = true, t_measure = true, x_measure = true, y_measure = true, z_measure = true,...
                            dM_X_source = true, dM_Y_source = true, dM_Z_source = true,...
                            dM_W_source = true, phi_source = true,...
                            custom_ports = custom_ports,...
                            length_A = length_A_feed, length_B = length_B_feed,...
                            internal_concentration_gradient = internal_concentration_gradient,...
                            flux_area = A_m, Re_min = Re_min,...
                            dynamic_compressibility = dynamic_compressibility,...
                            scaling_x = scaling_x, scaling_y = scaling_y, scaling_z = scaling_z,...
                            x_eq = x_eq, K_G_x = K_G_x, s_x = s_x,...
                            A_nucleation_x = A_nucleation_x,...
                            aspect_ratio_x = aspect_ratio_x,...
                            scales_per_area_x = scales_per_area_x,...
                            alpha_x = alpha_x,...
                            F_detach_x = F_detach_x,...
                            F_detach_buffer_x = F_detach_buffer_x,...
                            Mscale_x0 = Mscale_x0,...
                            y_eq = y_eq, K_G_y = K_G_y, s_y = s_y,...
                            A_nucleation_y = A_nucleation_y,...
                            aspect_ratio_y = aspect_ratio_y,...
                            scales_per_area_y = scales_per_area_y,...
                            alpha_y = alpha_y,...
                            F_detach_y = F_detach_y,...
                            F_detach_buffer_y = F_detach_buffer_y,...
                            Mscale_y0 = Mscale_y0,...
                            z_eq = z_eq, K_G_z = K_G_z, s_z = s_z,...
                            A_nucleation_z = A_nucleation_z,...
                            aspect_ratio_z = aspect_ratio_z,...
                            scales_per_area_z = scales_per_area_z,...
                            alpha_z = alpha_z,...
                            F_detach_z = F_detach_z,...
                            F_detach_buffer_z = F_detach_buffer_z,...
                            Mscale_z0 = Mscale_z0);
    end
end
components (ExternalAccess = observe)
    perm_pipe = customization.solution.elements.pipe(...
                        length = length, area = area_perm, Dh = D_perm,...
                        length_add = 0, roughness = roughness,...
                        Re_lam = Re_lam, Re_tur = Re_tur,...
                        shape_factor = shape_factor, Nu_lam = Nu_lam,...
                        p0 = P0_perm, x0 = x0_perm, y0 = y0_perm, z0 = z0_perm,...
                        p_measure = true, t_measure = true, x_measure = true, y_measure = true, z_measure = true,...
                        pi_measure = true,...
                        dM_X_source = true, dM_Y_source = true, dM_Z_source = true,...
                        dM_W_source = true, phi_source = true,...
                        custom_ports = custom_ports, length_A = length_A_perm, length_B = length_B_perm,...
                        dynamic_compressibility = dynamic_compressibility);
end

if polarization_type == customization.membranes.polarization_options.discrete
    connections
        connect(F,feed_pipe1.A);
        connect(feed_pipe1.B,feed_chamber.A);
        connect(feed_pipe2.A,feed_chamber.B);
        connect(B,feed_pipe2.B);
        connect(boundary_chamber.P, membrane_eqs.P_A);
        connect(boundary_chamber.T, membrane_eqs.T_A);
        connect(boundary_chamber.X, membrane_eqs.x_A);
        connect(boundary_chamber.Y, membrane_eqs.y_A);
        connect(boundary_chamber.Z, membrane_eqs.z_A);
        connect(membrane_eqs.mdot_A_x, boundary_chamber.dM_X);
        connect(membrane_eqs.mdot_A_y, boundary_chamber.dM_Y);
        connect(membrane_eqs.mdot_A_z, boundary_chamber.dM_Z);
        connect(membrane_eqs.mdot_A_w, boundary_chamber.dM_W);
        connect(membrane_eqs.Phi_A, boundary_chamber.Phi);
        connect(feed_chamber.C,boundary_chamber.A);
    end
else
    connections
        connect(F,feed_chamber.A)
        connect(B,feed_chamber.B)
        connect(feed_chamber.P, membrane_eqs.P_A);
        connect(feed_chamber.T, membrane_eqs.T_A);
        connect(feed_chamber.X, membrane_eqs.x_A);
        connect(feed_chamber.Y, membrane_eqs.y_A);
        connect(feed_chamber.Z, membrane_eqs.z_A);
        connect(feed_chamber.coverage,membrane_eqs.a_loss);
        connect(membrane_eqs.mdot_A_x, feed_chamber.dM_X);
        connect(membrane_eqs.mdot_A_y, feed_chamber.dM_Y);
        connect(membrane_eqs.mdot_A_z, feed_chamber.dM_Z);
        connect(membrane_eqs.mdot_A_w, feed_chamber.dM_W);
        connect(membrane_eqs.Phi_A, feed_chamber.Phi);
    end
    equations
        feed_chamber.P_wall == perm_pipe.P - perm_pipe.PI;
    end
end

connections
    connect(perm_pipe.P, membrane_eqs.P_B);
    connect(perm_pipe.T, membrane_eqs.T_B);
    connect(perm_pipe.X, membrane_eqs.x_B);
    connect(perm_pipe.Y, membrane_eqs.y_B);
    connect(perm_pipe.Z, membrane_eqs.z_B);
    connect(membrane_eqs.mdot_B_x, perm_pipe.dM_X);
    connect(membrane_eqs.mdot_B_y, perm_pipe.dM_Y);
    connect(membrane_eqs.mdot_B_z, perm_pipe.dM_Z);
    connect(membrane_eqs.mdot_B_w, perm_pipe.dM_W);
    connect(membrane_eqs.Phi_B, perm_pipe.Phi);
    connect(F,membrane_eqs.F);
    connect(P1,perm_pipe.A);
    connect(P2,perm_pipe.B);
end

end