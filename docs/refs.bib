@Article{Robertson2022,
  author       = {Robertson, Bryson and Dunkle, Gabrielle and Mundon, Tim and Kilcher, Levi},
  journal      = {International Marine Energy Journal},
  title        = {Wave resource spatial and temporal variability dependence on WEC size},
  year         = {2022},
  month        = {Jun.},
  number       = {1},
  pages        = {113–121},
  volume       = {5},
  abstractnote = {&amp;lt;p&amp;gt;As the wave energy sector grows and looks to the Blue Economy for commercialization opportunities, there is a distinct and pressing need to clearly understand and quantify the coupled impacts of wave energy converter (WEC) size and wave resource characteristics on the annual energy production, spatial variability and temporal variability. Utilizing generic frequency domain representations of the Oscilla Power Triton WEC and spectral wave conditions at PacWave (Oregon), Los Angeles (California) and WETS (Hawaii), a series of interesting results emerge. Firstly, the ‘optimal’ WEC size, from an energy standpoint, is fundamentally dependent on the frequency distribution of the incoming wave variance density spectrum. Secondly, and from a seasonality perspective, the seasonal WEC energy generation doesn’t necessarily follow the seasonal distribution of gross wave power. Finally, from an hourly power variability perspective, a reduction in WEC size generally decreases variability. However, for each of the locations investigated, there appears to be a WEC size threshold; a threshold where further reducing WEC size results in increased power variability.&amp;lt;/p&amp;gt;},
  doi          = {10.36688/imej.5.113-121},
  file         = {:Lit/managing-editor,+104-Article+Manuscript-1342-1-6-20211215_edit.pdf:PDF},
  groups       = {Hydrodynamics, WEC Systems},
  url          = {https://marineenergyjournal.org/imej/article/view/104},
}

@Article{Ren2025,
  author   = {Jianbo Ren and Guorong Xu and Heli Zhao and Quan Kang},
  journal  = {Process Safety and Environmental Protection},
  title    = {Wave energy powered reverse osmosis seawater desalination: Research development and future perspective},
  year     = {2025},
  issn     = {0957-5820},
  pages    = {107978},
  volume   = {203},
  abstract = {Seawater desalination represented by reverse osmosis (SWRO) is providing an efficacious solution to meet the global freshwater scarcity. Nevertheless, the high energy input derived from the requirement of high operation pressure is still a challenge, which is detrimental for controlling carbon footprint (CF) and fossil energy consumption desired for sustainable development. As a green renewable energy resource (RES), wave energy provides an alternative to be integrated with SWRO to decrease its CF. In this review, we analyzed and discussed variable wave powered desalination systems including indirect configuration in which wave energy was firstly used to generate electricity and then active RO system, and direct configuration in which wave energy was used mechanically to power desalination. Notably, For each kind configuration, we gave detailed analysis and discussion taking various factors such as application scenarios, cost, and potential for commercialization under consideration. Based on the discussion and analysis, the challenges in push forward wave powered RO desalination is analyzed. It’s anticipated that cost, long-term performance evaluation, environmental issues, energy recovery, and membrane materials are main factors affecting the scalability and commercialization. Based on challenges analysis, we proposed perspective for wave powered seawater desalination. We believed that the content discussed here is anticipated to provide unique clues for exploring more efficient wave powered desalination system and promoting its large-scale applications in future.},
  doi      = {https://doi.org/10.1016/j.psep.2025.107978},
  file     = {:Lit/2025wddsreview.pdf:PDF},
  groups   = {Direct Drive Desal},
  keywords = {Renewable energy, Wave energy, Seawater desalination, Energy efficiency, Sustainability},
  url      = {https://www.sciencedirect.com/science/article/pii/S0957582025012455},
}

