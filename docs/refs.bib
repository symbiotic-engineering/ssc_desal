@Article{Suchithra2022,
author     = {Suchithra, R. and Das, Tapas K. and Rajagopalan, Krishnakumar and Chaudhuri, Abhijit and Ulm, Nicholas and Prabu, Maheandera and Samad, Abdus and Cross, Patrick},
journal    = {Ocean Engineering},
title      = {Numerical modelling and design of a small-scale wave-powered desalination system},
year       = {2022},
issn       = {0029-8018},
month      = jul,
pages      = {111419},
volume     = {256},
abstract   = {The present work describes the design and analysis of a compact and modular wave-powered desalination (WPD) system. The design of the unit is influenced by the United States Department of Energy (DOE) Waves to Water competition rules. The system consists of a flap-type wave surge converter that converts wave energy into hydraulic piston force through a double-acting cylinder working as a power takeoff (PTO) device. The dimensions of the flap are determined through frequency domain analysis under different sea states and the required discharge of desalinated water. Further, the whole system, including the reverse osmosis (RO) module, is modeled using WEC-Sim (an open-source code) and Simscape/SimHydraulics toolbox in MATLAB. The analysis of the system under six different sea states shows encouraging results for freshwater production. Considering the sea states studied here, the designed system can generate more than 50 bar pressure of the seawater feed discharge and produce up to 100 L/h of freshwater with TDS less than 500 mg/L. It was also observed that the use of an accumulator reduces the fluctuation in feed flow and feed pressure at the inlet of the RO module, resulting in improved system efficiency.},
comment    = {Pre-treatment is on the draw side of the piston.},
date       = {2022-05-17},
day        = {17},
doi        = {10.1016/j.oceaneng.2022.111419},
file       = {:Lit/numerical modeling wave desal.pdf:PDF},
groups     = {Direct Drive Desal},
keywords   = {Wave-powered desalination, Wave surge converter, Reverse osmosis, Seawater desalination, Wave energy},
publisher  = {Elsevier BV},
readstatus = {skimmed},
}

@Article{Rosati2023,
author     = {Rosati, Marco and Ringwood, John V.},
journal    = {Renewable Energy},
title      = {Control co-design of power take-off and bypass valve for OWC-based wave energy conversion systems},
year       = {2023},
issn       = {0960-1481},
month      = dec,
pages      = {119523},
volume     = {219},
abstract   = {Wave energy is a significant source of renewable energy harnessed by wave energy converters (WECs). However, due to the relatively high levelised cost of energy (LCoE), wave energy has not attained a commercial stage yet. To minimise the LCoE, since the optimum (uncontrolled) WEC design typically differs from the optimum controlled WEC design, control co-design (CCD) techniques are essential. With CCD, the WEC control-related aspects are taken into account from the start of the WEC design phase and, ideally, the best control-informed WEC design is then achieved. This paper specifically focuses on CCD for an oscillating-watercolumn (OWC) WEC, equipped with a Wells turbine and a bypass valve. In essence, a parametric CCD approach is devised to find the optimum (control-informed) turbine rotor diameter, and bypass valve diameter, for the considered OWC WEC. In particular, the optimum design parameters minimise a 'simplified' LCoE, which is chosen as a suitable performance function. Despite the LCoE is primarily sensitive to the power takeoff size, rather than to the bypass valve size, peak-shaving control with a bypass valve potentially increases the capacity factor and, consequently, can minimise the LCoE for small-to-medium sized turbines.},
comment    = {valve shaves peaks off powerflux, allowing for smaller PTOs},
date       = {2023-10-27},
day        = {27},
doi        = {10.1016/j.renene.2023.119523},
file       = {:Lit/pneumatic relief valve control.pdf:PDF},
groups     = {WEC PTO, Optimization, Controls},
keywords   = {Bypass valve, Control co-design, Levelised cost of energy, Oscillating-water-column, Wave energy, Wells turbine},
publisher  = {Elsevier BV},
readstatus = {skimmed},
}

@Article{Falnes1980,
